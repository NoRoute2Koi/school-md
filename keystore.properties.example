# Keystore configuration for signing release APKs
# Copy this file to "keystore.properties" (in project root or in app/)
# Do NOT commit keystore.properties or your .jks file (both are ignored by .gitignore)

# Path to the keystore file (can be relative to project root or to app/)
storeFile=app/release.jks

# Keystore and key passwords
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
